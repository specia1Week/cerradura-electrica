# URL del proyecto Supabase (público).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anon/public. Se usa en el navegador y en el middleware.
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Clave service_role. SOLO se usa en Server Actions y Route Handlers.
# Nunca debe llevar el prefijo NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
