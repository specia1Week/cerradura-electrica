# =============================================================================
# Sistema de Control de Acceso y Asistencia Biométrico (RFID + Huella)
# Variables de entorno para DESARROLLO
#
# Uso:
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (Windows PowerShell)
#
# Reemplaza todos los valores "change_me_*" antes de levantar el entorno.
# NUNCA versiones el archivo .env ni secretos reales.
# =============================================================================

# -----------------------------------------------------------------------------
# Proyecto / zona horaria
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=access-control
NODE_ENV=development
TZ=UTC

# -----------------------------------------------------------------------------
# PostgreSQL 16
# -----------------------------------------------------------------------------
POSTGRES_DB=access_control
POSTGRES_USER=access_user
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_PORT=5432

# URL interna usada por el backend dentro de la red Docker.
# Si cambias POSTGRES_USER, POSTGRES_PASSWORD o POSTGRES_DB, actualiza también
# esta URL. Usa caracteres URL-safe en las contraseñas de desarrollo.
DATABASE_URL=postgresql://access_user:change_me_postgres@postgres:5432/access_control?schema=public

# -----------------------------------------------------------------------------
# Redis 7
# -----------------------------------------------------------------------------
REDIS_PASSWORD=change_me_redis
REDIS_PORT=6379

# URL interna usada por el backend dentro de la red Docker.
# Si cambias REDIS_PASSWORD, actualiza también esta URL.
REDIS_URL=redis://:change_me_redis@redis:6379

# -----------------------------------------------------------------------------
# Eclipse Mosquitto 2
# -----------------------------------------------------------------------------
MQTT_USERNAME=access_backend
MQTT_PASSWORD=change_me_mqtt
MQTT_PORT=1883
# Interfaz del host donde se publica MQTT.
# 127.0.0.1 = solo el host (más seguro, recomendado por defecto).
# Usa la IP de tu host o 0.0.0.0 para conectar el ESP32 desde la LAN.
MQTT_BIND_IP=127.0.0.1

# URL interna usada por el backend dentro de la red Docker.
# Si cambias MQTT_USERNAME o MQTT_PASSWORD, actualiza también esta URL.
MQTT_URL=mqtt://access_backend:change_me_mqtt@mosquitto:1883

# Topics preparados para la Fase 0 (QoS 1). "+" representa el device_id.
MQTT_TOPIC_ACCESS_EVENTS=devices/+/access-events
MQTT_TOPIC_HEARTBEAT=devices/+/heartbeat
MQTT_QOS=1

# -----------------------------------------------------------------------------
# Backend NestJS
# -----------------------------------------------------------------------------
BACKEND_PORT=3000
BACKEND_HOST=0.0.0.0

# URLs internas entre servicios (red Docker).
BACKEND_INTERNAL_URL=http://backend:3000
FRONTEND_INTERNAL_URL=http://frontend:3000

# Origen permitido para CORS (frontend accesible desde el host).
CORS_ORIGIN=http://localhost:3001

# -----------------------------------------------------------------------------
# Autenticación del panel (JWT)
# -----------------------------------------------------------------------------
# Generar un valor seguro, por ejemplo: openssl rand -hex 32
JWT_SECRET=change_me_generate_a_64_char_hex_secret
JWT_EXPIRES_IN=15m

# -----------------------------------------------------------------------------
# Frontend Next.js 15
# -----------------------------------------------------------------------------
FRONTEND_PORT=3001

# URL del backend visible desde el navegador del usuario.
NEXT_PUBLIC_API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# TLS / reverse proxy (referencia para producción; no se usa en Fase 0)
# -----------------------------------------------------------------------------
DOMAIN=localhost
ACME_EMAIL=admin@example.com
